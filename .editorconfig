root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,md}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[gradlew]
end_of_line = lf

[gradlew.bat]
end_of_line = crlf
