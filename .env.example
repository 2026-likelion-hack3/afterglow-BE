# 이 파일을 복사해 .env로 만들고 실제 값을 채워 사용한다. .env는 git에 커밋하지 않는다.
#
# local 프로파일(application-local.yml)은 DB_USERNAME/DB_PASSWORD가 없으면
# afterglow/afterglow 기본값을 사용한다. docker-compose.yml로 로컬 PostgreSQL을
# 띄울 때도 아래 값을 사용한다.

# --- 로컬 PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=afterglow
POSTGRES_USER=afterglow
POSTGRES_PASSWORD=afterglow

# --- Spring 애플리케이션 (local 프로파일 실행 시, docker-compose 값과 맞춘다) ---
DB_USERNAME=afterglow
DB_PASSWORD=afterglow
# 호스트 포트 — docker-compose.yml의 컨테이너 노출 포트와 application-local.yml 접속 URL
# 양쪽에서 동시에 이 변수 하나만 읽는다(따로 관리하지 않음). 기본값 5433 —
# Windows에 PostgreSQL이 네이티브 서비스로 설치된 경우 기본 5432를 그 서비스가 이미
# 점유하고 있어, docker-compose PostgreSQL을 다른 포트로 분리했다.
# (네이티브 PostgreSQL을 쓰기로 했다면 이 값을 5432로 바꾼다 — docker-compose와 앱 양쪽에
# 자동으로 같이 적용된다. 단, `docker compose`는 .env를 자동으로 읽지만 `./gradlew bootRun`은
# 읽지 않으므로, 앱 실행 셸/IntelliJ 설정에도 DB_PORT를 동일하게 export해야 한다.)
DB_PORT=5433

# --- prod 프로파일 전용 (실제 값은 배포 환경 변수로만 주입, 이 파일에는 예시 이름만 둔다) ---
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=

# --- JWT (local/prod 모두 필수 — repository에 기본값을 두지 않는다. 미지정 시 기동 실패) ---
# openssl rand -base64 48 등으로 32바이트 이상의 값을 직접 생성해서 채운다.
JWT_SECRET=
# JWT_EXPIRATION_SECONDS=2592000

# --- SES 이메일 발송 (prod 전용, local/test는 로그 스텁을 쓰므로 불필요) ---
# AWS 자격증명 자체는 EC2 인스턴스 IAM role의 기본 자격증명 체인을 사용한다 — 별도 키를 여기에 넣지 않는다.
# AWS_REGION=ap-northeast-2
# SES_SENDER_EMAIL=
