# 이 파일을 복사해 .env로 만들고 실제 값을 채워 사용한다. .env는 git에 커밋하지 않는다.
#
# local 프로파일(application-local.yml)은 DB_USERNAME/DB_PASSWORD가 없으면
# afterglow/afterglow 기본값을 사용한다. docker-compose.yml로 로컬 PostgreSQL을
# 띄울 때도 아래 값을 사용한다.

# --- 로컬 PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=afterglow
POSTGRES_USER=afterglow
POSTGRES_PASSWORD=afterglow
# 호스트에서 5432 포트가 이미 사용 중이면 다른 포트로 바꾼다.
POSTGRES_PORT=5432

# --- Spring 애플리케이션 (local 프로파일 실행 시, docker-compose 값과 맞춘다) ---
DB_USERNAME=afterglow
DB_PASSWORD=afterglow

# --- prod 프로파일 전용 (실제 값은 배포 환경 변수로만 주입, 이 파일에는 예시 이름만 둔다) ---
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=

# --- JWT (local은 기본값 사용 가능, prod는 반드시 배포 환경변수로 별도 지정) ---
# JWT_SECRET=
# JWT_EXPIRATION_SECONDS=2592000

# --- SES 이메일 발송 (prod 전용, local/test는 로그 스텁을 쓰므로 불필요) ---
# AWS 자격증명 자체는 EC2 인스턴스 IAM role의 기본 자격증명 체인을 사용한다 — 별도 키를 여기에 넣지 않는다.
# AWS_REGION=ap-northeast-2
# SES_SENDER_EMAIL=
